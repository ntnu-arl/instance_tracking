@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

get_filename_component(instance_tracking_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

find_dependency(config_utilities REQUIRED)
find_dependency(OpenCV REQUIRED)

if(NOT TARGET instance_tracking::instance_tracking)
  include("${instance_tracking_CMAKE_DIR}/instance_trackingTargets.cmake")
endif()

set(instance_tracking_LIBRARIES instance_tracking::instance_tracking)

check_required_components(instance_tracking)
